<Window x:Class="MediaPlayerSauce.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="Media Player (Sauce Edition)" Width="1100" Height="680" MinWidth="480" MinHeight="320"
        Background="{StaticResource Back}" Foreground="{StaticResource Text}" FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" AllowDrop="True" Icon="/MediaPlayer.ico">
    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- the menu bar -->
        <Menu x:Name="MenuBar" Grid.Row="0" Padding="4,2">
            <MenuItem Header="_Media" Style="{StaticResource TopMenu}">
                <MenuItem x:Name="MnuOpen" Header="_Open file..." InputGestureText="Ctrl+O" />
                <MenuItem x:Name="MnuOpenFolder" Header="Open _folder..." InputGestureText="Ctrl+F" />
                <MenuItem x:Name="MnuOpenDisc" Header="Open _disc..." InputGestureText="Ctrl+D" />
                <MenuItem x:Name="MnuOpenUrl" Header="Open _network stream..." InputGestureText="Ctrl+N" />
                <MenuItem x:Name="MnuOnline" Header="_Watch online (YouTube, Netflix, Prime Video)..." InputGestureText="/" />
                <MenuItem x:Name="MnuRecent" Header="Open _recent" />
                <Separator />
                <MenuItem x:Name="MnuSavePlaylist" Header="_Save playlist..." InputGestureText="Ctrl+Y" />
                <MenuItem x:Name="MnuConvert" Header="_Convert / save a copy..." InputGestureText="Ctrl+R" />
                <Separator />
                <MenuItem x:Name="MnuQuit" Header="_Quit" InputGestureText="Ctrl+Q" />
            </MenuItem>
            <MenuItem Header="_Playback" Style="{StaticResource TopMenu}">
                <MenuItem x:Name="MnuPlay" Header="_Play / pause" InputGestureText="Space" />
                <MenuItem x:Name="MnuStop" Header="_Stop" InputGestureText="S" />
                <MenuItem x:Name="MnuPrev" Header="P_revious" InputGestureText="P" />
                <MenuItem x:Name="MnuNext" Header="_Next" InputGestureText="N" />
                <Separator />
                <MenuItem x:Name="MnuSpeed" Header="Spee_d" />
                <MenuItem x:Name="MnuJump" Header="_Jump to a time..." InputGestureText="Ctrl+T" />
                <MenuItem x:Name="MnuBack" Header="Back 10 seconds" InputGestureText="Left" />
                <MenuItem x:Name="MnuFwd" Header="Forward 10 seconds" InputGestureText="Right" />
                <MenuItem x:Name="MnuFrame" Header="Next _frame" InputGestureText="E" />
                <MenuItem x:Name="MnuAB" Header="_A-B repeat" InputGestureText="Shift+L" />
                <Separator />
                <MenuItem x:Name="MnuTitle" Header="_Title" />
                <MenuItem x:Name="MnuChapter" Header="_Chapter" />
                <MenuItem x:Name="MnuDiscMenu" Header="Disc _menu" />
                <Separator />
                <MenuItem x:Name="MnuLoop" Header="_Loop" />
                <MenuItem x:Name="MnuShuffle" Header="Shu_ffle" IsCheckable="True" />
            </MenuItem>
            <MenuItem Header="_Audio" Style="{StaticResource TopMenu}">
                <MenuItem x:Name="MnuAudioTrack" Header="Audio _track" />
                <MenuItem x:Name="MnuAudioDevice" Header="Audio _device" />
                <MenuItem x:Name="MnuStereo" Header="_Stereo mode" />
                <MenuItem x:Name="MnuVisual" Header="_Visualisation" />
                <Separator />
                <MenuItem x:Name="MnuVolUp" Header="Volume _up" InputGestureText="Up" />
                <MenuItem x:Name="MnuVolDown" Header="Volume _down" InputGestureText="Down" />
                <MenuItem x:Name="MnuMute" Header="_Mute" InputGestureText="M" />
                <MenuItem x:Name="MnuNormalize" Header="Even out loud and quiet parts" IsCheckable="True" />
                <MenuItem x:Name="MnuAddAudio" Header="Add an audio file..." />
            </MenuItem>
            <MenuItem Header="_Video" Style="{StaticResource TopMenu}">
                <MenuItem x:Name="MnuVideoTrack" Header="Video _track" />
                <MenuItem x:Name="MnuFullscreen" Header="_Full screen" InputGestureText="F" />
                <MenuItem x:Name="MnuOnTop" Header="Always on _top" />
                <MenuItem x:Name="MnuFit" Header="Window fits the _video" />
                <Separator />
                <MenuItem x:Name="MnuAspect" Header="_Aspect ratio" />
                <MenuItem x:Name="MnuCrop" Header="_Crop" />
                <MenuItem x:Name="MnuZoom" Header="_Zoom" />
                <MenuItem x:Name="MnuDeinterlace" Header="_Deinterlace" />
                <MenuItem x:Name="MnuRotate" Header="_Rotate and flip" />
                <Separator />
                <MenuItem x:Name="MnuSnapshot" Header="Take a _snapshot" InputGestureText="Shift+S" />
            </MenuItem>
            <MenuItem Header="_Subtitles" Style="{StaticResource TopMenu}">
                <MenuItem x:Name="MnuSubTrack" Header="Subtitle _track" />
                <MenuItem x:Name="MnuAddSub" Header="_Add a subtitle file..." />
                <Separator />
                <MenuItem x:Name="MnuSubLater" Header="Show subtitles later" InputGestureText="H" />
                <MenuItem x:Name="MnuSubSooner" Header="Show subtitles sooner" InputGestureText="G" />
                <MenuItem x:Name="MnuSubSize" Header="Subtitle _size" />
            </MenuItem>
            <MenuItem Header="_Tools" Style="{StaticResource TopMenu}">
                <MenuItem x:Name="MnuEffects" Header="_Effects and filters..." InputGestureText="Ctrl+E" />
                <MenuItem x:Name="MnuSync" Header="_Sync sound and subtitles..." />
                <MenuItem x:Name="MnuInfo" Header="Media _information..." InputGestureText="Ctrl+I" />
                <Separator />
                <MenuItem x:Name="MnuPrefs" Header="_Preferences..." InputGestureText="Ctrl+P" />
            </MenuItem>
            <MenuItem Header="V_iew" Style="{StaticResource TopMenu}">
                <MenuItem x:Name="MnuPlaylist" Header="_Playlist" InputGestureText="Ctrl+L" IsCheckable="True" />
                <MenuItem x:Name="MnuMinimal" Header="_Minimal view (no menu)" InputGestureText="Ctrl+H" IsCheckable="True" />
                <MenuItem x:Name="MnuBigger" Header="Make everything bigger" InputGestureText="Ctrl+Plus" />
                <MenuItem x:Name="MnuSmaller" Header="Make everything smaller" InputGestureText="Ctrl+Minus" />
            </MenuItem>
            <MenuItem Header="_Help" Style="{StaticResource TopMenu}">
                <MenuItem x:Name="MnuKeys" Header="_Keyboard shortcuts" InputGestureText="F1" />
                <MenuItem x:Name="MnuOpenWith" Header="Add to Explorer's 'Open with'" />
                <MenuItem x:Name="MnuAbout" Header="_About" />
            </MenuItem>
        </Menu>

        <!-- the picture and the playlist -->
        <Grid Grid.Row="1" x:Name="Middle">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="PlaylistCol" Width="0" />
            </Grid.ColumnDefinitions>

            <Grid x:Name="VideoArea" Background="Black" ClipToBounds="True">
                <vlc:VideoView x:Name="Video" />
                <Image x:Name="SnapshotPicture" Stretch="Uniform" Visibility="Collapsed" />
            </Grid>

            <!-- the overlay: goes inside the video view (live) or on top of the picture (snapshots) -->
            <Grid x:Name="Overlay" Background="#01000000">
                <!-- nothing open: a friendly start page -->
                <Grid x:Name="Welcome" Background="{StaticResource Back}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="560" Margin="24">
                        <Grid Width="84" Height="84" HorizontalAlignment="Center">
                            <Ellipse Fill="{StaticResource Accent}" />
                            <TextBlock Text="&#xE768;" FontFamily="{StaticResource Icons}" FontSize="34" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="6,0,0,0" />
                        </Grid>
                        <TextBlock Text="Media Player" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,16,0,0" />
                        <TextBlock Text="Sauce Edition" FontSize="13" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" Margin="0,0,0,6" />
                        <TextBlock Text="Drop videos, music, folders or playlists here, or pick something below." Style="{StaticResource Dim}" TextAlignment="Center" Margin="0,4,0,18" />
                        <WrapPanel HorizontalAlignment="Center">
                            <Button x:Name="BtnWOpen" Style="{StaticResource AccentBtn}" Margin="4" Padding="16,9">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8E5;" FontFamily="{StaticResource Icons}" Margin="0,1,8,0" /><TextBlock Text="Open a file" /></StackPanel>
                            </Button>
                            <Button x:Name="BtnWFolder" Margin="4" Padding="16,9">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE838;" FontFamily="{StaticResource Icons}" Margin="0,1,8,0" /><TextBlock Text="Open a folder" /></StackPanel>
                            </Button>
                            <Button x:Name="BtnWDisc" Margin="4" Padding="16,9">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE958;" FontFamily="{StaticResource Icons}" Margin="0,1,8,0" /><TextBlock Text="Play a disc" /></StackPanel>
                            </Button>
                            <Button x:Name="BtnWUrl" Margin="4" Padding="16,9">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE71B;" FontFamily="{StaticResource Icons}" Margin="0,1,8,0" /><TextBlock Text="Stream from an address" /></StackPanel>
                            </Button>
                            <Button x:Name="BtnWOnline" Margin="4" Padding="16,9">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE774;" FontFamily="{StaticResource Icons}" Margin="0,1,8,0" /><TextBlock Text="Watch online" /></StackPanel>
                            </Button>
                        </WrapPanel>
                        <TextBlock x:Name="LblRecent" Text="RECENT" Style="{StaticResource H2}" Margin="4,22,0,4" FontSize="11" />
                        <ItemsControl x:Name="RecentList" MaxHeight="210">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Tag="{Binding Path}" Click="Recent_Click" HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0" Padding="8,6" Margin="0,1" ToolTip="{Binding Path}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="24" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource Icons}" Foreground="{StaticResource TextDim}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{Binding Note}" Foreground="{StaticResource Accent}" FontSize="11" VerticalAlignment="Center" Margin="12,0,0,0" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>

                <!-- music: the cover and the names -->
                <Grid x:Name="AudioPanel" Visibility="Collapsed">
                    <Grid.Background>
                        <RadialGradientBrush Center="0.5,0.4" RadiusX="0.8" RadiusY="0.8">
                            <GradientStop Color="#2A1E1A" Offset="0" />
                            <GradientStop Color="#0E0E10" Offset="1" />
                        </RadialGradientBrush>
                    </Grid.Background>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
                        <Border Width="240" Height="240" CornerRadius="12" Background="#24242B" HorizontalAlignment="Center" ClipToBounds="True">
                            <Border.Effect><DropShadowEffect BlurRadius="30" ShadowDepth="6" Opacity="0.6" /></Border.Effect>
                            <Grid>
                                <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource Icons}" FontSize="80" Foreground="{StaticResource TextFaint}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Image x:Name="ImgCover" Stretch="UniformToFill" />
                            </Grid>
                        </Border>
                        <TextBlock x:Name="LblSong" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,22,0,2" MaxWidth="560" />
                        <TextBlock x:Name="LblArtist" FontSize="14" Foreground="{StaticResource TextDim}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="560" />
                    </StackPanel>
                </Grid>

                <!-- messages on the picture -->
                <Border x:Name="Osd" Background="#C0101012" CornerRadius="6" Padding="12,6" Margin="18" HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="Collapsed" IsHitTestVisible="False">
                    <TextBlock x:Name="OsdText" FontSize="16" Foreground="White" />
                </Border>
                <Border x:Name="Notice" Background="#E6262329" BorderBrush="{StaticResource Accent}" BorderThickness="0,0,0,3" CornerRadius="6" Padding="14,10" Margin="18"
                        HorizontalAlignment="Center" VerticalAlignment="Top" MaxWidth="640" Visibility="Collapsed">
                    <DockPanel>
                        <Button x:Name="BtnNoticeClose" DockPanel.Dock="Right" Style="{StaticResource IconBtn}" Width="28" Height="28" FontSize="11" Content="&#xE711;" Margin="10,0,0,0" VerticalAlignment="Top" />
                        <TextBlock x:Name="NoticeText" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </DockPanel>
                </Border>
                <Border x:Name="BufferBox" Background="#C0101012" CornerRadius="20" Padding="16,8" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False">
                    <TextBlock x:Name="BufferText" Foreground="White" FontSize="14" />
                </Border>
            </Grid>

            <!-- the playlist -->
            <Border x:Name="PlaylistPanel" Grid.Column="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="12,10,6,6">
                        <TextBlock Text="Playlist" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="BtnPlAdd" Style="{StaticResource IconBtn}" Width="30" Height="30" FontSize="13" Content="&#xE710;" ToolTip="Add files" />
                            <Button x:Name="BtnPlMore" Style="{StaticResource IconBtn}" Width="30" Height="30" FontSize="13" Content="&#xE712;" ToolTip="Sort, save, clear" />
                        </StackPanel>
                    </Grid>
                    <TextBox x:Name="TxtFilter" DockPanel.Dock="Top" Margin="10,0,10,6" ToolTip="Find in the playlist" />
                    <TextBlock x:Name="LblPlCount" DockPanel.Dock="Bottom" Foreground="{StaticResource TextFaint}" FontSize="11" Margin="12,6" />
                    <ListBox x:Name="PlaylistList" Style="{StaticResource PlainList}" ItemContainerStyle="{StaticResource PlainItem}" SelectionMode="Extended" AllowDrop="True"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="Now" Text="&#xE768;" FontFamily="{StaticResource Icons}" FontSize="10" Foreground="{StaticResource Accent}" VerticalAlignment="Center" Visibility="Hidden" />
                                    <TextBlock x:Name="T" Grid.Column="1" Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Path}" />
                                    <TextBlock Grid.Column="2" Text="{Binding Duration}" Foreground="{StaticResource TextFaint}" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0" />
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                        <Setter TargetName="Now" Property="Visibility" Value="Visible" />
                                        <Setter TargetName="T" Property="Foreground" Value="{StaticResource Accent}" />
                                        <Setter TargetName="T" Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
            <GridSplitter x:Name="PlaylistSplitter" Grid.Column="1" Width="5" HorizontalAlignment="Left" Background="Transparent" ResizeBehavior="PreviousAndCurrent" />
        </Grid>

        <!-- the controls -->
        <Border x:Name="Controls" Grid.Row="2" Background="{StaticResource Panel}" Padding="14,4,14,8">
            <StackPanel>
                <Grid Margin="0,0,0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="LblTime" Text="0:00" Foreground="{StaticResource TextDim}" FontSize="12" VerticalAlignment="Center" MinWidth="52" />
                    <Grid Grid.Column="1" Margin="8,0">
                        <Slider x:Name="Seek" Maximum="1000" />
                        <Border x:Name="AbMark" Height="4" Background="#80FFC24A" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed" />
                        <Popup x:Name="SeekTip" Placement="Relative" PlacementTarget="{Binding ElementName=Seek}" AllowsTransparency="True" IsHitTestVisible="False">
                            <Border Background="#E0202026" CornerRadius="4" Padding="7,3"><TextBlock x:Name="SeekTipText" Foreground="White" FontSize="12" /></Border>
                        </Popup>
                    </Grid>
                    <TextBlock x:Name="LblLength" Grid.Column="2" Text="0:00" Foreground="{StaticResource TextDim}" FontSize="12" VerticalAlignment="Center" MinWidth="52" TextAlignment="Right" Cursor="Hand" ToolTip="Click to show the time left" />
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ToggleButton x:Name="BtnPlaylist" Style="{StaticResource IconBtn}" Content="&#xE8FD;" ToolTip="Playlist (Ctrl+L)" />
                        <ToggleButton x:Name="BtnLoop" Style="{StaticResource IconBtn}" Content="&#xE8EE;" ToolTip="Loop: off" />
                        <ToggleButton x:Name="BtnShuffle" Style="{StaticResource IconBtn}" Content="&#xE8B1;" ToolTip="Shuffle" />
                        <Button x:Name="BtnEffects" Style="{StaticResource IconBtn}" Content="&#xE9E9;" ToolTip="Effects and filters (Ctrl+E)" />
                        <Button x:Name="BtnSpeed" Style="{StaticResource IconBtn}" Width="Auto" MinWidth="38" Padding="6,0" FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold" Content="1x" ToolTip="Speed" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BtnStop" Style="{StaticResource IconBtn}" Content="&#xE71A;" ToolTip="Stop (S)" />
                        <Button x:Name="BtnPrev" Style="{StaticResource IconBtn}" Content="&#xE892;" ToolTip="Previous (P)" Margin="6,0,0,0" />
                        <Button x:Name="BtnPlay" Style="{StaticResource PlayBtn}" Content="&#xE768;" ToolTip="Play (Space)" Margin="8,0" />
                        <Button x:Name="BtnNext" Style="{StaticResource IconBtn}" Content="&#xE893;" ToolTip="Next (N)" Margin="0,0,6,0" />
                        <Button x:Name="BtnFull" Style="{StaticResource IconBtn}" Content="&#xE740;" ToolTip="Full screen (F)" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="BtnSubs" Style="{StaticResource IconBtn}" Content="&#xE7F0;" ToolTip="Subtitles and sound tracks" />
                        <Button x:Name="BtnMute" Style="{StaticResource IconBtn}" Content="&#xE767;" ToolTip="Mute (M)" />
                        <Slider x:Name="Vol" Width="96" Maximum="200" Value="80" VerticalAlignment="Center" ToolTip="Volume" SmallChange="5" LargeChange="10" />
                        <TextBlock x:Name="LblVol" Text="80%" Foreground="{StaticResource TextDim}" FontSize="12" Width="40" TextAlignment="Right" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
