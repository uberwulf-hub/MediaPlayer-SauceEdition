<!-- Watch online: YouTube search (results laid out like YouTube's search page), Netflix and Prime Video. Everything
     plays in its own Edge window (WebVideos.OpenInEdge). Code in Dialogs.Online.cs. -->
<Window x:Class="MediaPlayerSauce.UI.OnlineWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Watch online - Media Player" Background="{StaticResource Panel}" Foreground="{StaticResource Text}"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True" WindowStartupLocation="CenterOwner"
        Width="1000" Height="740" MinWidth="620" MinHeight="420" ShowInTaskbar="True" ResizeMode="CanResize">
    <DockPanel Margin="22,16,10,0">
        <!-- source tabs -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,12,0">
            <Button x:Name="BtnClose" DockPanel.Dock="Right" Style="{StaticResource IconBtn}" Focusable="True" Content="&#xE711;" FontSize="13"
                    ToolTip="Close (Esc)" AutomationProperties.Name="Close"/>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <RadioButton x:Name="TabYouTube" Style="{StaticResource TabPill}" GroupName="OnlineSource" IsChecked="True" AutomationProperties.Name="YouTube">
                    <StackPanel Orientation="Horizontal">
                        <Border Background="#FF0033" CornerRadius="4" Width="20" Height="14" Margin="0,0,7,0" VerticalAlignment="Center">
                            <Path Data="M0,0 L6,3.5 L0,7 Z" Fill="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="YouTube" FontSize="14"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="TabNetflix" Style="{StaticResource TabPill}" GroupName="OnlineSource" AutomationProperties.Name="Netflix">
                    <TextBlock Text="Netflix" FontSize="14"/>
                </RadioButton>
                <RadioButton x:Name="TabPrime" Style="{StaticResource TabPill}" GroupName="OnlineSource" AutomationProperties.Name="Prime Video">
                    <TextBlock Text="Prime Video" FontSize="14"/>
                </RadioButton>
            </StackPanel>
        </DockPanel>

        <!-- search box: grows with the window up to 640 px, like YouTube's -->
        <Grid DockPanel.Dock="Top" Margin="0,16,12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100*" MaxWidth="640"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid MinWidth="200">
                <TextBox x:Name="TxtSearch" FontSize="15" Padding="18,8,34,8" AutomationProperties.Name="Search"/>
                <TextBlock Text="&#xE721;" FontFamily="{StaticResource Icons}" FontSize="14" Foreground="{StaticResource TextFaint}"
                           VerticalAlignment="Center" HorizontalAlignment="Left" Margin="13,0,0,0" IsHitTestVisible="False"/>
                <TextBlock x:Name="LblHint" Text="Search YouTube" Foreground="{StaticResource TextFaint}" FontSize="15" VerticalAlignment="Center"
                           Margin="39,0,0,0" IsHitTestVisible="False"/>
                <Button x:Name="BtnClear" Style="{StaticResource IconBtn}" Focusable="True" Width="30" Height="30" FontSize="11" Content="&#xE711;" HorizontalAlignment="Right"
                        Margin="0,0,4,0" ToolTip="Clear" Visibility="Collapsed" AutomationProperties.Name="Clear the search"/>
            </Grid>
            <Button x:Name="BtnSearch" Grid.Column="1" Style="{StaticResource AccentBtn}" Margin="10,0,0,0" Padding="18,8" FontSize="14"
                    Content="Search" ToolTip="Search (Enter)" AutomationProperties.Name="Search"/>
        </Grid>

        <!-- status line: searching, no results, problems -->
        <DockPanel x:Name="PnlStatus" DockPanel.Dock="Top" Margin="0,12,12,0" Visibility="Collapsed">
            <Button x:Name="BtnWeb" DockPanel.Dock="Right" Margin="12,0,0,0" Content="Open the search on youtube.com" Visibility="Collapsed"/>
            <TextBlock x:Name="LblStatus" Foreground="{StaticResource TextDim}" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center"/>
        </DockPanel>

        <Grid Margin="0,14,0,0">
            <!-- YouTube before the first search: recent searches -->
            <StackPanel x:Name="PnlHome" Margin="0,6,12,0">
                <TextBlock x:Name="LblRecent" Style="{StaticResource H2}" Text="Recent searches" Margin="0,0,0,10"/>
                <WrapPanel x:Name="PnlRecent"/>
                <TextBlock Style="{StaticResource Dim}" Foreground="{StaticResource TextFaint}" FontSize="12.5" Margin="0,14,0,0" MaxWidth="620" HorizontalAlignment="Left"
                           Text="Videos open in their own YouTube window (YouTube only plays in a browser), so captions, quality and your YouTube account all work there. Media Player pauses while you watch."/>
            </StackPanel>

            <!-- YouTube results, laid out like YouTube's search page -->
            <ListBox x:Name="LstResults" Style="{StaticResource PlainList}" Visibility="Collapsed"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel" VirtualizingPanel.VirtualizationMode="Recycling"
                     AutomationProperties.Name="YouTube results">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="{x:Type ListBoxItem}" BasedOn="{StaticResource PlainItem}">
                        <Setter Property="AutomationProperties.Name" Value="{Binding Title}"/>
                        <Setter Property="Padding" Value="8"/>
                        <Setter Property="Margin" Value="0,0,8,4"/>
                        <Setter Property="Cursor" Value="Hand"/>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="272" Height="153" CornerRadius="10" Background="{StaticResource Panel2}" VerticalAlignment="Top">
                                <Grid>
                                    <Border CornerRadius="10">
                                        <Border.Background>
                                            <ImageBrush ImageSource="{Binding Thumb, Converter={StaticResource WebImage}, ConverterParameter=544}" Stretch="UniformToFill"/>
                                        </Border.Background>
                                    </Border>
                                    <Border x:Name="Badge" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,8,8" CornerRadius="4" Padding="5,1" Background="#CC000000">
                                        <TextBlock Text="{Binding Badge}" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                                    </Border>
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="16,0,8,0">
                                <TextBlock Text="{Binding Title}" Foreground="{StaticResource Text}" FontSize="17" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="48" LineHeight="23"/>
                                <TextBlock Text="{Binding Meta}" Foreground="{StaticResource TextDim}" FontSize="12.5" Margin="0,4,0,0"/>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Ellipse Width="24" Height="24" Fill="{StaticResource Track}"/>
                                    <Ellipse Width="24" Height="24" Margin="-24,0,0,0">
                                        <Ellipse.Fill>
                                            <ImageBrush ImageSource="{Binding Avatar, Converter={StaticResource WebImage}, ConverterParameter=48}" Stretch="UniformToFill"/>
                                        </Ellipse.Fill>
                                    </Ellipse>
                                    <TextBlock Text="{Binding Channel}" Foreground="{StaticResource TextDim}" FontSize="12.5" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="Check" Text="&#xE73E;" FontFamily="{StaticResource Icons}" FontSize="10" Foreground="{StaticResource TextDim}" Margin="5,1,0,0"
                                               VerticalAlignment="Center" Visibility="Collapsed"/>
                                </StackPanel>
                                <TextBlock x:Name="Snip" Text="{Binding Snippet}" Foreground="{StaticResource TextDim}" FontSize="12" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                           MaxHeight="34" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding HasBadge}" Value="False"><Setter TargetName="Badge" Property="Visibility" Value="Collapsed"/></DataTrigger>
                            <DataTrigger Binding="{Binding IsLive}" Value="True"><Setter TargetName="Badge" Property="Background" Value="#CC0000"/></DataTrigger>
                            <DataTrigger Binding="{Binding Verified}" Value="True"><Setter TargetName="Check" Property="Visibility" Value="Visible"/></DataTrigger>
                            <DataTrigger Binding="{Binding HasSnippet}" Value="False"><Setter TargetName="Snip" Property="Visibility" Value="Collapsed"/></DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Netflix / Prime Video: copy-protected, so they open in Edge -->
            <StackPanel x:Name="PnlStream" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,12,60" MaxWidth="560" Visibility="Collapsed">
                <TextBlock x:Name="LblStreamName" FontSize="46" FontWeight="Black" HorizontalAlignment="Center"/>
                <TextBlock x:Name="LblStreamText" Style="{StaticResource Dim}" FontSize="14" TextAlignment="Center" Margin="0,14,0,0"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,22,0,0">
                    <Button x:Name="BtnStreamOpen" Style="{StaticResource AccentBtn}" Padding="18,8" FontSize="15" FontWeight="SemiBold"/>
                    <Button x:Name="BtnStreamSearch" Margin="10,0,0,0" Padding="18,8" FontSize="15" Visibility="Collapsed"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
