<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>false</UseWindowsForms>
    <AssemblyName>MediaPlayerSE</AssemblyName>
    <RootNamespace>MediaPlayerSauce</RootNamespace>
    <ApplicationIcon>MediaPlayer.ico</ApplicationIcon>
    <Product>Media Player (Sauce Edition)</Product>
    <Version>0.4.0</Version>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- self-contained only when published (toolsRelease.ps1), so the tests can reference it -->
    <!-- only the 64-bit libVLC: the app is 64-bit -->
    <VlcWindowsX86Enabled>false</VlcWindowsX86Enabled>
    <VlcWindowsArm64Enabled>false</VlcWindowsArm64Enabled>
    <VlcWindowsX64Enabled>true</VlcWindowsX64Enabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LibVLCSharp.WPF" Version="3.10.2" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.24" />
  </ItemGroup>

  <!-- libVLC loads its plugins from libvlcwin-x64 beside the program: in a single-file build they stay real files -->
  <Target Name="KeepVlcBesideTheExe" AfterTargets="CollectVlcFilesToCopyWindows">
    <ItemGroup>
      <Content Condition="$([System.String]::Copy('%(Content.Link)').StartsWith('libvlc'))">
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </Content>
    </ItemGroup>
  </Target>

  <ItemGroup>
    <VlcWindowsX64ExcludeFiles Include="libvlc.lib;libvlccore.lib" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="MediaPlayer.ico" />
    <InternalsVisibleTo Include="MediaPlayerSE.Tests" />
  </ItemGroup>

</Project>
